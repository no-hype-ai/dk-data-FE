# DK Data Platform - Production Environment Variables
# Copy this file to .env for production deployment
#
# SECURITY: Never commit actual credentials to version control!

# =============================================================================
# Server Configuration
# =============================================================================
SERVER_DOMAIN=data.yourdomain.com

# =============================================================================
# Database - REQUIRED (use strong passwords!)
# =============================================================================
POSTGRES_DB=edwards_tavr
POSTGRES_USER=dk_data_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_PORT=5432

# PostgREST authenticator password
POSTGREST_PASSWORD=CHANGE_ME_POSTGREST_SECRET

# JWT Secret for PostgREST (generate with: openssl rand -base64 32)
PGRST_JWT_SECRET=CHANGE_ME_JWT_SECRET_32_CHARS_MIN

# =============================================================================
# Service Ports (internal, not exposed in production)
# =============================================================================
POSTGREST_PORT=3030
JOB_TRIGGER_PORT=8000
METABASE_PORT=3000
FRONTEND_PORT=3001

# =============================================================================
# Monitoring (optional, enable with --profile monitoring)
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# =============================================================================
# Database Admin (optional, enable with --profile dbadmin)
# =============================================================================
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# =============================================================================
# External APIs (optional)
# =============================================================================
CHEMBL_API_KEY=
PUBCHEM_API_KEY=
OPENFDA_API_KEY=

# =============================================================================
# Observability
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=dk-data-platform
LOG_LEVEL=WARNING

# =============================================================================
# Redis Cache (optional)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
ENRICHMENT_CACHE_TTL=86400
ENRICHMENT_CACHE_BACKEND=redis
ENRICHMENT_REDIS_URL=redis://redis:6379/0
