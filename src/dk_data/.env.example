# DK Data Platform Environment Variables
# Copy this file to .env and fill in the values
#
# SECURITY NOTE: Never commit actual credentials to version control!
# The .env file should be in .gitignore

# Database - REQUIRED
# Set your actual database credentials here
POSTGRES_DB=edwards_tavr
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Or use a full DATABASE_URL instead:
# DATABASE_URL=postgresql://user:password@host:port/dbname

# API Configuration
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# Redis (optional)
REDIS_HOST=redis
REDIS_PORT=6379

# External APIs (optional)
CHEMBL_API_KEY=
PUBCHEM_API_KEY=
OPENFDA_API_KEY=

# Drug Enrichment Service
ENRICHMENT_CACHE_TTL=86400
ENRICHMENT_CACHE_BACKEND=redis
ENRICHMENT_REDIS_URL=redis://redis:6379/0
ENRICHMENT_ENABLE_EXTERNAL_APIS=true
ENRICHMENT_ENABLE_METRICS=true

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=dk-data-platform
