{
  "__metadata": {
    "name": "datasource-health",
    "folder": "Applications",
    "description": "Data Source Health — per-source freshness, ingestion volume, fetch duration, error rate, duplicate detection, medallion flow, storage growth, API consumer usage",
    "tags": ["dk-data", "data-platform", "datasource-health", "auto-provisioned"],
    "version": "1.0.0",
    "maintainer": "data-platform-team",
    "status": "active"
  },
  "dashboard": {
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": { "type": "grafana", "uid": "-- Grafana --" },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "description": "Data Source Health — per-source freshness, ingestion volume, fetch duration, error rate, duplicate detection, medallion flow, storage growth, API consumer usage",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [

      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "id": 100,
        "title": "Freshness",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Staleness hours per data source. Green < 4h / Yellow 4–24h / Red > 24h. Requires dk_data_source_staleness_hours emission — shows \"No data\" until staleness emission is deployed.",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "unit": "h",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 4 },
                { "color": "red", "value": 24 }
              ]
            },
            "color": { "mode": "thresholds" }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
        "id": 1,
        "options": {
          "mergeValues": true,
          "rowHeight": 0.9,
          "showValue": "auto",
          "alignValue": "left",
          "fillOpacity": 70,
          "legendDisplayMode": "list",
          "legendPlacement": "bottom"
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "dk_data_source_staleness_hours{source_name=~\"$source\"}",
            "legendFormat": "{{source_name}}",
            "refId": "A"
          }
        ],
        "title": "Source Freshness (hours since last refresh)",
        "type": "state-timeline",
        "options_nullValueMode": "null"
      },

      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
        "id": 101,
        "title": "Ingestion Volume",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Records ingested per second per source (5-minute rate). Uses recording rule job:dk_pipeline_records_processed:rate5m for 30-day range performance.",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "unit": "ops",
            "custom": {
              "fillOpacity": 20,
              "lineWidth": 1,
              "stacking": { "mode": "normal", "group": "A" }
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
        "id": 2,
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "job:dk_pipeline_records_processed:rate5m{source=~\"$source\"}",
            "legendFormat": "{{source}}",
            "refId": "A"
          }
        ],
        "title": "Ingestion Volume (records/sec)",
        "type": "timeseries"
      },

      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
        "id": 102,
        "title": "Fetch Duration",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Fetch duration p50 and p95 per source. Uses recording rules for 30-day range performance. High p95 values indicate API slowdowns or rate limiting.",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "unit": "s",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 0
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byFrameRefID", "options": "P95" },
              "properties": [
                { "id": "custom.lineStyle", "value": { "dash": [5, 5], "fill": "dash" } },
                { "id": "displayName", "value": "p95 {{source}}" }
              ]
            },
            {
              "matcher": { "id": "byFrameRefID", "options": "P50" },
              "properties": [
                { "id": "displayName", "value": "p50 {{source}}" }
              ]
            }
          ]
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
        "id": 3,
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "job:dk_pipeline_duration_seconds_p50:5m{source=~\"$source\"}",
            "legendFormat": "p50 {{source}}",
            "refId": "P50"
          },
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "job:dk_pipeline_duration_seconds_p95:5m{source=~\"$source\"}",
            "legendFormat": "p95 {{source}}",
            "refId": "P95"
          }
        ],
        "title": "Fetch Duration p50 / p95",
        "type": "timeseries"
      },

      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
        "id": 103,
        "title": "Error Rate",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Ingestion errors in the last 24 hours per source and error type. Sorted descending to surface the worst offenders first.",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "unit": "short",
            "color": { "mode": "palette-classic" }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
        "id": 4,
        "options": {
          "barWidth": 0.6,
          "groupWidth": 0.7,
          "stacking": "none",
          "xTickLabelRotation": -30,
          "legend": { "displayMode": "list", "placement": "bottom" },
          "tooltip": { "mode": "single" }
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "sort_desc(sum by (source, error_type) (increase(dk_bronze_ingestion_errors_total{source=~\"$source\"}[24h])))",
            "legendFormat": "{{source}} / {{error_type}}",
            "refId": "A"
          }
        ],
        "title": "Ingestion Errors by Source (last 24h)",
        "type": "barchart"
      },

      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
        "id": 104,
        "title": "Duplicate Detection",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Rate of duplicate fetches detected via response_body_hash match. High rate means the source is returning identical data and we're wasting bandwidth. Shows \"No data\" until dk_pipeline_duplicate_fetches_total emission is deployed.",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "unit": "ops",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 37 },
        "id": 5,
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "rate(dk_pipeline_duplicate_fetches_total{source=~\"$source\"}[5m])",
            "legendFormat": "{{source}}",
            "refId": "A"
          }
        ],
        "title": "Duplicate Fetch Rate (per source)",
        "type": "timeseries"
      },

      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
        "id": 105,
        "title": "Medallion Flow",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Records flowing through raw → bronze → silver → gold with backlog counts at each stage. Uses netsage-sankey-panel v1.1.4. When silver/gold unprocessed metrics are absent, falls back to dk_layer_record_count totals (not source-filtered in fallback mode).",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data"
          },
          "overrides": []
        },
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 46 },
        "id": 6,
        "options": {
          "srcField": "from",
          "dstField": "to",
          "sizeField": "value"
        },
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "from": "from",
                "to": "to",
                "Value": "value"
              }
            }
          }
        ],
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "label_replace(label_replace(sum(dk_raw_unprocessed_total{source=~\"$source\"}), \"from\", \"raw\", \"\", \"\"), \"to\", \"bronze\", \"\", \"\")",
            "instant": true,
            "format": "table",
            "legendFormat": "",
            "refId": "A"
          },
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "label_replace(label_replace(sum(dk_bronze_unprocessed_total{source=~\"$source\"}) or sum(dk_bronze_unprocessed_records{source=~\"$source\"}), \"from\", \"bronze\", \"\", \"\"), \"to\", \"silver\", \"\", \"\")",
            "instant": true,
            "format": "table",
            "legendFormat": "",
            "refId": "B"
          },
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "label_replace(label_replace(sum(dk_silver_unprocessed_total{source=~\"$source\"}) or sum(dk_layer_record_count{layer=\"silver\"}), \"from\", \"silver\", \"\", \"\"), \"to\", \"gold\", \"\", \"\")",
            "instant": true,
            "format": "table",
            "legendFormat": "",
            "refId": "C"
          }
        ],
        "title": "Medallion Pipeline Flow (raw → bronze → silver → gold)",
        "type": "netsage-sankey-panel"
      },

      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 56 },
        "id": 106,
        "title": "Storage Growth",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Row count per data source over time. Use for capacity planning and detecting unexpected growth or drops.",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "unit": "short",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 5
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
        "id": 7,
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "dk_data_source_row_count{source_name=~\"$source\"}",
            "legendFormat": "{{source_name}}",
            "refId": "A"
          }
        ],
        "title": "Storage — Row Count",
        "type": "timeseries"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Table size in bytes per data source. Uses recording rule job:dk_data_source_table_size_bytes:last for 30-day range. Shows \"No data\" until table_size_bytes emission is deployed.",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "unit": "bytes",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 5
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
        "id": 8,
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "job:dk_data_source_table_size_bytes:last{source_name=~\"$source\"}",
            "legendFormat": "{{source_name}}",
            "refId": "A"
          }
        ],
        "title": "Storage — Table Size (bytes)",
        "type": "timeseries"
      },

      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 65 },
        "id": 107,
        "title": "API Consumer Usage",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "API requests per consumer and schema in the last hour. Shows who is using the data platform and at what volume.",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "unit": "short",
            "color": { "mode": "palette-classic" }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 66 },
        "id": 9,
        "options": {
          "barWidth": 0.6,
          "xTickLabelRotation": -30,
          "legend": { "displayMode": "list", "placement": "bottom" },
          "tooltip": { "mode": "single" }
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "sort_desc(sum by (consumer, schema) (increase(dk_data_metering_requests_total[1h])))",
            "legendFormat": "{{consumer}} / {{schema}}",
            "refId": "A"
          }
        ],
        "title": "API Requests by Consumer (last 1h)",
        "type": "barchart"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Response bytes per consumer and schema over time (5-minute rate). Helps identify high-bandwidth consumers.",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "unit": "Bps",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 66 },
        "id": 10,
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "rate(dk_data_metering_response_bytes_total[5m])",
            "legendFormat": "{{consumer}} / {{schema}}",
            "refId": "A"
          }
        ],
        "title": "Response Bytes per Consumer (bytes/sec)",
        "type": "timeseries"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Rate limit rejections per consumer in the last hour. Consumers hitting rejections consistently should have their quota reviewed.",
        "fieldConfig": {
          "defaults": {
            "noValue": "No data",
            "unit": "short",
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "red", "value": 10 }
              ]
            }
          },
          "overrides": []
        },
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 66 },
        "id": 11,
        "options": {
          "barWidth": 0.6,
          "xTickLabelRotation": -30,
          "legend": { "displayMode": "list", "placement": "bottom" },
          "tooltip": { "mode": "single" }
        },
        "targets": [
          {
            "datasource": { "type": "prometheus", "uid": "${datasource}" },
            "expr": "sort_desc(sum by (consumer) (increase(dk_data_metering_rate_limit_rejections_total[1h])))",
            "legendFormat": "{{consumer}}",
            "refId": "A"
          }
        ],
        "title": "Rate Limit Rejections by Consumer (last 1h)",
        "type": "barchart"
      }

    ],
    "refresh": "5m",
    "schemaVersion": 39,
    "tags": ["dk-data", "data-platform", "datasource-health", "auto-provisioned"],
    "templating": {
      "list": [
        {
          "current": { "selected": false, "text": "Mimir", "value": "mimir" },
          "hide": 0,
          "includeAll": false,
          "label": "Datasource",
          "multi": false,
          "name": "datasource",
          "options": [],
          "query": "prometheus",
          "refresh": 1,
          "type": "datasource"
        },
        {
          "current": { "selected": true, "text": "All", "value": "$__all" },
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "definition": "label_values(dk_data_source_staleness_hours, source_name)",
          "hide": 0,
          "includeAll": true,
          "allValue": ".*",
          "label": "Source",
          "multi": true,
          "name": "source",
          "query": "label_values(dk_data_source_staleness_hours, source_name)",
          "refresh": 2,
          "sort": 1,
          "type": "query"
        }
      ]
    },
    "time": { "from": "now-24h", "to": "now" },
    "title": "Data Source Health",
    "uid": "datasource-health"
  }
}
