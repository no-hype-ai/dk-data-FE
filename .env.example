# Environment Variables for dk-data-fe
# Feature: 002-production-readiness
# Task: T021
#
# Copy this file to .env and fill in the values.
# NEVER commit .env files with actual credentials to git.
#
# For production, use Doppler to manage secrets:
#   doppler run -- docker compose up
#
# For local development:
#   cp .env.example .env
#   # Edit .env with your local values
#   docker compose up

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=  # REQUIRED: Set a strong password
POSTGRES_DB=dk_data

# PostgREST authenticator password (separate from postgres superuser)
POSTGREST_PASSWORD=  # REQUIRED: Set a strong password

# =============================================================================
# JWT Configuration
# =============================================================================
# JWT secret for PostgREST authentication
# Generate with: openssl rand -base64 32
PGRST_JWT_SECRET=  # REQUIRED for authenticated endpoints

# =============================================================================
# Service Ports (local development)
# =============================================================================
POSTGRES_PORT=5433
POSTGREST_PORT=3030
JOB_TRIGGER_PORT=8000
METABASE_PORT=3000

# =============================================================================
# Optional: AI Enrichment
# =============================================================================
# Anthropic API key for AI-powered enrichment features
ANTHROPIC_API_KEY=  # Optional: sk-ant-...

# =============================================================================
# Optional: Observability (production)
# =============================================================================
# OpenTelemetry exporter endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=  # e.g., alloy.infra.svc.cluster.local:4317
OTEL_ENABLED=true

# Logging level
LOG_LEVEL=info

# =============================================================================
# Molecule Platform Configuration (004-molecule-platform-integration)
# =============================================================================
# Batch processing settings
BATCH_SIZE=100
FETCH_MODE=incremental
TRANSFORM_LAYERS=all

# Feature toggles
ENABLE_FETCH=true
ENABLE_TRANSFORM=true
ENABLE_RESOLUTION=true

# Entity resolution threshold (0.0-1.0)
ENTITY_RESOLUTION_THRESHOLD=0.80

# External API keys (optional, improves rate limits)
# CHEMBL_API_KEY=  # Optional: for higher rate limits
# PUBCHEM_API_KEY=  # Optional: for higher rate limits
