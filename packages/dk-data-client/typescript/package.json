{
  "name": "@datakinetic/dk-data-client",
  "version": "0.1.0",
  "description": "First-party client for dk-data (behaviorlabs data platform) — auth, caching, fallback, telemetry.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "peerDependencies": {
    "ioredis": "^5.3.0",
    "better-sqlite3": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": { "optional": true },
    "better-sqlite3": { "optional": true }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "keywords": [
    "dk-data",
    "behaviorlabs",
    "healthcare",
    "drug-data"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datakinetic/dk-data-FE"
  },
  "license": "UNLICENSED",
  "private": true
}
