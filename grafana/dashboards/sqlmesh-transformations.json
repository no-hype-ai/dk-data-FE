{
  "id": null,
  "uid": "dk-sqlmesh-transforms",
  "title": "SQLMesh Transformations",
  "description": "Health and row counts for bronze → silver → gold SQLMesh transformation pipeline",
  "tags": ["dk-data", "sqlmesh", "pipeline"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": {"from": "now-24h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Pipeline Overview",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Bronze Tables",
      "type": "stat",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 3, "w": 4, "x": 0, "y": 1},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#c47d15"}, "unit": "short"}},
      "targets": [{"rawSql": "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = 'mol_bronze' AND table_name NOT LIKE '%__%'", "format": "table", "rawQuery": true, "refId": "A"}]
    },
    {
      "id": 3,
      "title": "Silver Tables",
      "type": "stat",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 3, "w": 4, "x": 4, "y": 1},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#c0c0c0"}, "unit": "short"}},
      "targets": [{"rawSql": "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = 'mol_silver' AND table_name NOT LIKE '%__%'", "format": "table", "rawQuery": true, "refId": "A"}]
    },
    {
      "id": 4,
      "title": "Gold Tables",
      "type": "stat",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 3, "w": 4, "x": 8, "y": 1},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "#ffd700"}, "unit": "short"}},
      "targets": [{"rawSql": "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = 'mol_gold' AND table_name NOT LIKE '%__%'", "format": "table", "rawQuery": true, "refId": "A"}]
    },
    {
      "id": 5,
      "title": "SQLMesh Registered Snapshots",
      "type": "stat",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 3, "w": 4, "x": 12, "y": 1},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}, "unit": "short"}},
      "targets": [{"rawSql": "SELECT COUNT(*) FROM sqlmesh._snapshots", "format": "table", "rawQuery": true, "refId": "A"}]
    },
    {
      "id": 6,
      "title": "Transform Jobs (24h)",
      "type": "stat",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 3, "w": 4, "x": 16, "y": 1},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}, "unit": "short"}},
      "targets": [{"rawSql": "SELECT COUNT(*) FROM ops.ingestion_jobs WHERE started_at >= NOW() - INTERVAL '24 hours' AND status = 'failed'", "format": "table", "rawQuery": true, "refId": "A"}]
    },
    {
      "id": 10,
      "title": "mol_bronze Layer",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 4},
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Bronze Model Row Counts",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 12, "w": 12, "x": 0, "y": 5},
      "options": {"footer": {"show": false}},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Rows"}, "properties": [{"id": "color", "mode": "thresholds"}, {"id": "thresholds", "value": {"steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 100}]}}]}
        ]
      },
      "targets": [{
        "rawSql": "SELECT table_name AS \"Model\", 'mol_bronze' AS \"Schema\", (xpath('/row/c/text()', query_to_xml(format('SELECT COUNT(*) AS c FROM mol_bronze.%I', table_name), false, true, '')))[1]::text::int AS \"Rows\" FROM information_schema.tables WHERE table_schema = 'mol_bronze' AND table_name NOT LIKE '%__%' ORDER BY table_name",
        "format": "table",
        "rawQuery": true,
        "refId": "A"
      }]
    },
    {
      "id": 12,
      "title": "SQLMesh Snapshot Registry by Schema",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 12, "w": 12, "x": 12, "y": 5},
      "options": {"footer": {"show": false}},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Snapshots"}, "properties": [{"id": "color", "mode": "thresholds"}, {"id": "thresholds", "value": {"steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 5}]}}]}
        ]
      },
      "targets": [{
        "rawSql": "SELECT SPLIT_PART(name, '.', 2) AS \"Schema\", COUNT(*) AS \"Snapshots\", COUNT(DISTINCT SPLIT_PART(name, '.', 3)) AS \"Models\" FROM sqlmesh._snapshots GROUP BY 1 ORDER BY 2 DESC",
        "format": "table",
        "rawQuery": true,
        "refId": "A"
      }]
    },
    {
      "id": 20,
      "title": "mol_silver & mol_gold Layers",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17},
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Silver Model Row Counts (key tables)",
      "type": "bargauge",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 18},
      "options": {"orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"]}, "displayMode": "gradient", "valueMode": "color"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "continuous-GrYlRd"}}},
      "targets": [{
        "rawSql": "SELECT 'molecules' AS metric, COUNT(*) AS value FROM mol_silver.molecules UNION ALL SELECT 'clinical_trials', COUNT(*) FROM mol_silver.clinical_trials UNION ALL SELECT 'adverse_events', COUNT(*) FROM mol_silver.adverse_events UNION ALL SELECT 'bioactivity', COUNT(*) FROM mol_silver.bioactivity UNION ALL SELECT 'drug_labels', COUNT(*) FROM mol_silver.drug_labels UNION ALL SELECT 'identifier_mappings', COUNT(*) FROM mol_silver.identifier_mappings UNION ALL SELECT 'targets', COUNT(*) FROM mol_silver.targets UNION ALL SELECT 'epo_patents', COUNT(*) FROM mol_silver.epo_patents UNION ALL SELECT 'financial_filings', COUNT(*) FROM mol_silver.financial_filings ORDER BY value DESC",
        "format": "table",
        "rawQuery": true,
        "refId": "A"
      }]
    },
    {
      "id": 22,
      "title": "Gold Model Row Counts",
      "type": "bargauge",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 18},
      "options": {"orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"]}, "displayMode": "gradient", "valueMode": "color"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "continuous-GrYlRd"}}},
      "targets": [{
        "rawSql": "SELECT 'molecule_profile' AS metric, COUNT(*) AS value FROM mol_gold.molecule_profile UNION ALL SELECT 'safety_signals', COUNT(*) FROM mol_gold.safety_signals UNION ALL SELECT 'lifecycle_stages', COUNT(*) FROM mol_gold.lifecycle_stages UNION ALL SELECT 'competitive_landscape', COUNT(*) FROM mol_gold.competitive_landscape UNION ALL SELECT 'regulatory_timeline', COUNT(*) FROM mol_gold.regulatory_timeline UNION ALL SELECT 'advocacy_groups', COUNT(*) FROM mol_gold.advocacy_groups UNION ALL SELECT 'company_pipeline', COUNT(*) FROM mol_gold.company_pipeline ORDER BY value DESC",
        "format": "table",
        "rawQuery": true,
        "refId": "A"
      }]
    },
    {
      "id": 30,
      "title": "Transformation Job Performance",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28},
      "collapsed": false
    },
    {
      "id": 31,
      "title": "Job Duration by Source (Last 7d avg)",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 29},
      "options": {"footer": {"show": false}},
      "fieldConfig": {
        "defaults": {"custom": {"align": "left"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Avg Duration (s)"}, "properties": [{"id": "unit", "value": "s"}, {"id": "color", "mode": "thresholds"}, {"id": "thresholds", "value": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 60}, {"color": "red", "value": 300}]}}]},
          {"matcher": {"id": "byName", "options": "Max Duration (s)"}, "properties": [{"id": "unit", "value": "s"}]}
        ]
      },
      "targets": [{
        "rawSql": "SELECT source AS \"Source\", ROUND(AVG(EXTRACT(EPOCH FROM (completed_at - started_at)))::numeric, 1) AS \"Avg Duration (s)\", ROUND(MAX(EXTRACT(EPOCH FROM (completed_at - started_at)))::numeric, 1) AS \"Max Duration (s)\", COUNT(*) AS \"Runs\", SUM(records_processed) AS \"Total Records\" FROM ops.ingestion_jobs WHERE started_at >= NOW() - INTERVAL '7 days' AND completed_at IS NOT NULL GROUP BY source ORDER BY \"Avg Duration (s)\" DESC",
        "format": "table",
        "rawQuery": true,
        "refId": "A"
      }]
    },
    {
      "id": 32,
      "title": "Transformation Duration Over Time",
      "type": "timeseries",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 29},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"fillOpacity": 5}}},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}},
      "targets": [{
        "rawSql": "SELECT started_at AS time, source AS metric, EXTRACT(EPOCH FROM (completed_at - started_at)) AS value FROM ops.ingestion_jobs WHERE started_at >= NOW() - INTERVAL '7 days' AND completed_at IS NOT NULL ORDER BY started_at",
        "format": "time_series",
        "rawQuery": true,
        "refId": "A"
      }]
    },
    {
      "id": 33,
      "title": "Records Processed per Run",
      "type": "timeseries",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 39},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"fillOpacity": 10}}},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["sum", "max"]}},
      "targets": [{
        "rawSql": "SELECT started_at AS time, source AS metric, records_processed AS value FROM ops.ingestion_jobs WHERE started_at >= NOW() - INTERVAL '7 days' AND status = 'completed' ORDER BY started_at",
        "format": "time_series",
        "rawQuery": true,
        "refId": "A"
      }]
    },
    {
      "id": 40,
      "title": "SQLMesh Environment State",
      "type": "row",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 47},
      "collapsed": false
    },
    {
      "id": 41,
      "title": "SQLMesh prod Environment",
      "type": "table",
      "datasource": {"type": "postgres", "uid": "postgres"},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 48},
      "options": {"footer": {"show": false}},
      "fieldConfig": {"defaults": {"custom": {"align": "left"}},
        "overrides": [
          {"matcher": {"id": "byName", "options": "Finalized At"}, "properties": [{"id": "unit", "value": "dateTimeAsIso"}]}
        ]
      },
      "targets": [{
        "rawSql": "SELECT name AS \"Environment\", plan_id AS \"Plan ID\", TO_TIMESTAMP(finalized_ts / 1000) AS \"Finalized At\", jsonb_array_length(snapshots::jsonb) AS \"Snapshot Count\" FROM sqlmesh._environments ORDER BY name",
        "format": "table",
        "rawQuery": true,
        "refId": "A"
      }]
    },
    {
      "id": 42,
      "title": "Prometheus — Bronze Ingestion Duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 54},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}},
      "targets": [{"expr": "histogram_quantile(0.95, rate(dk_bronze_ingestion_duration_seconds_bucket{job=\"dk-data-platform\"}[10m]))", "legendFormat": "p95 — {{source}}", "refId": "A"}]
    },
    {
      "id": 43,
      "title": "Prometheus — Pipeline Layer Duration",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 54},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}},
      "targets": [{"expr": "histogram_quantile(0.95, rate(dk_pipeline_processing_duration_seconds_bucket{job=\"dk-data-platform\"}[10m]))", "legendFormat": "p95 — {{layer}}", "refId": "A"}]
    }
  ]
}
