{
  "__metadata": {
    "name": "dk-data-cronjobs",
    "folder": "Applications",
    "description": "dk-data CronJob Monitor — status, failures, duration trends for batch ingestion jobs",
    "tags": ["dk-data", "cronjobs", "auto-provisioned"],
    "version": "1.0.0",
    "maintainer": "data-platform-team",
    "status": "active"
  },
  "dashboard": {
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": { "type": "grafana", "uid": "-- Grafana --" },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "description": "dk-data CronJob Monitor — status, failures, duration trends for batch ingestion jobs",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
        "id": 100,
        "title": "CronJob Status",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "CronJob status table: last schedule, next schedule, active jobs",
        "fieldConfig": {
          "defaults": {
            "custom": { "align": "auto", "displayMode": "auto" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Last Scheduled" },
              "properties": [{ "id": "unit", "value": "dateTimeFromNow" }]
            },
            {
              "matcher": { "id": "byName", "options": "Next Schedule" },
              "properties": [{ "id": "unit", "value": "dateTimeFromNow" }]
            },
            {
              "matcher": { "id": "byName", "options": "Active" },
              "properties": [
                { "id": "custom.displayMode", "value": "color-background-solid" },
                { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }] } }
              ]
            }
          ]
        },
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
        "id": 1,
        "options": { "showHeader": true, "sortBy": [{ "desc": false, "displayName": "CronJob" }] },
        "targets": [
          {
            "expr": "kube_cronjob_status_last_schedule_time{namespace=~\"$namespace\"} * 1000",
            "format": "table",
            "instant": true,
            "legendFormat": "",
            "refId": "A"
          },
          {
            "expr": "kube_cronjob_next_schedule_time{namespace=~\"$namespace\"} * 1000",
            "format": "table",
            "instant": true,
            "legendFormat": "",
            "refId": "B"
          },
          {
            "expr": "kube_cronjob_status_active{namespace=~\"$namespace\"}",
            "format": "table",
            "instant": true,
            "legendFormat": "",
            "refId": "C"
          }
        ],
        "title": "CronJob Status Overview",
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true, "__name__": true, "endpoint": true, "instance": true, "job": true, "uid": true, "namespace": false },
              "renameByName": { "Value #A": "Last Scheduled", "Value #B": "Next Schedule", "Value #C": "Active", "cronjob": "CronJob", "namespace": "Namespace" }
            }
          }
        ],
        "type": "table"
      },
      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
        "id": 200,
        "title": "Failure Timeline",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "CronJob failures over time",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
          }
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
        "id": 2,
        "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
        "targets": [
          {
            "expr": "increase(kube_job_status_failed{namespace=~\"$namespace\"}[$__rate_interval]) > 0",
            "legendFormat": "{{job_name}}",
            "refId": "A"
          }
        ],
        "title": "Job Failures",
        "type": "timeseries"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Total failures and successes in the selected time range",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 20 },
        "id": 3,
        "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
        "targets": [
          {
            "expr": "sum(increase(kube_job_status_succeeded{namespace=~\"$namespace\"}[$__range])) or vector(0)",
            "legendFormat": "Succeeded",
            "refId": "A"
          }
        ],
        "title": "Total Successes",
        "type": "stat"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Total job failures in the selected time range",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "red", "value": 1 }
              ]
            }
          }
        },
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 20 },
        "id": 4,
        "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
        "targets": [
          {
            "expr": "sum(increase(kube_job_status_failed{namespace=~\"$namespace\"}[$__range])) or vector(0)",
            "legendFormat": "Failed",
            "refId": "A"
          }
        ],
        "title": "Total Failures",
        "type": "stat"
      },
      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
        "id": 300,
        "title": "Duration Trends",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Job duration over time (completion time minus start time)",
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "palette-classic" },
            "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "auto", "spanNulls": true }
          }
        },
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
        "id": 5,
        "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
        "targets": [
          {
            "expr": "(kube_job_status_completion_time{namespace=~\"$namespace\"} - kube_job_status_start_time{namespace=~\"$namespace\"}) > 0",
            "legendFormat": "{{job_name}}",
            "refId": "A"
          }
        ],
        "title": "Job Duration",
        "type": "timeseries"
      },
      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
        "id": 400,
        "title": "Molecule Pipeline Jobs",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Molecule pipeline job statuses: mol-fetch-daily, mol-fetch-weekly, mol-fetch-monthly, mol-transform",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 },
        "id": 6,
        "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
        "targets": [
          {
            "expr": "increase(kube_job_status_succeeded{namespace=~\"$namespace\", job_name=~\"mol-.*\"}[$__rate_interval])",
            "legendFormat": "{{job_name}} ok",
            "refId": "A"
          },
          {
            "expr": "increase(kube_job_status_failed{namespace=~\"$namespace\", job_name=~\"mol-.*\"}[$__rate_interval])",
            "legendFormat": "{{job_name}} fail",
            "refId": "B"
          }
        ],
        "title": "Molecule Job Results",
        "type": "timeseries"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Molecule pipeline job durations",
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "palette-classic" },
            "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "auto", "spanNulls": true }
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 },
        "id": 7,
        "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
        "targets": [
          {
            "expr": "(kube_job_status_completion_time{namespace=~\"$namespace\", job_name=~\"mol-.*\"} - kube_job_status_start_time{namespace=~\"$namespace\", job_name=~\"mol-.*\"}) > 0",
            "legendFormat": "{{job_name}}",
            "refId": "A"
          }
        ],
        "title": "Molecule Job Duration Trends",
        "type": "timeseries"
      },
      {
        "collapsed": false,
        "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
        "id": 500,
        "title": "Backup Jobs",
        "type": "row"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Backup job statuses: pg-backup-daily, pg-backup-weekly, pg-backup-verify",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
        "id": 8,
        "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
        "targets": [
          {
            "expr": "increase(kube_job_status_succeeded{namespace=~\"$namespace\", job_name=~\"pg-backup-.*\"}[$__rate_interval])",
            "legendFormat": "{{job_name}} ok",
            "refId": "A"
          },
          {
            "expr": "increase(kube_job_status_failed{namespace=~\"$namespace\", job_name=~\"pg-backup-.*\"}[$__rate_interval])",
            "legendFormat": "{{job_name}} fail",
            "refId": "B"
          }
        ],
        "title": "Backup Job Results",
        "type": "timeseries"
      },
      {
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "description": "Backup job durations",
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "palette-classic" },
            "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "auto", "spanNulls": true }
          }
        },
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
        "id": 9,
        "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
        "targets": [
          {
            "expr": "(kube_job_status_completion_time{namespace=~\"$namespace\", job_name=~\"pg-backup-.*\"} - kube_job_status_start_time{namespace=~\"$namespace\", job_name=~\"pg-backup-.*\"}) > 0",
            "legendFormat": "{{job_name}}",
            "refId": "A"
          }
        ],
        "title": "Backup Job Duration Trends",
        "type": "timeseries"
      }
    ],
    "refresh": "1m",
    "schemaVersion": 39,
    "tags": ["dk-data", "cronjobs", "auto-provisioned"],
    "templating": {
      "list": [
        {
          "current": { "selected": false, "text": "Mimir", "value": "mimir" },
          "hide": 0,
          "includeAll": false,
          "label": "Datasource",
          "multi": false,
          "name": "datasource",
          "options": [],
          "query": "prometheus",
          "refresh": 1,
          "type": "datasource"
        },
        {
          "current": { "selected": false, "text": "dk-data-prod", "value": "dk-data-prod" },
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "definition": "label_values(kube_namespace_labels{namespace=~\"dk-data-.*\"}, namespace)",
          "hide": 0,
          "includeAll": true,
          "label": "Namespace",
          "multi": false,
          "name": "namespace",
          "query": "label_values(kube_namespace_labels{namespace=~\"dk-data-.*\"}, namespace)",
          "refresh": 2,
          "type": "query"
        },
        {
          "current": { "selected": false, "text": "All", "value": "$__all" },
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "definition": "label_values(kube_cronjob_info{namespace=~\"$namespace\"}, cronjob)",
          "hide": 0,
          "includeAll": true,
          "label": "CronJob",
          "multi": true,
          "name": "cronjob",
          "query": "label_values(kube_cronjob_info{namespace=~\"$namespace\"}, cronjob)",
          "refresh": 2,
          "type": "query"
        }
      ]
    },
    "time": { "from": "now-24h", "to": "now" },
    "title": "dk-data CronJob Monitor",
    "uid": "dk-data-cronjobs"
  }
}
