{
  "annotations": { "list": [] },
  "description": "dk-data-client adapter telemetry — hit/miss/fallthrough rates, p99 latency, top fallthrough methods. Fed by structured events emitted from packages/dk-data-client to Loki under app=adapter-telemetry. Feature 002-external-integration-foundation US-7.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total calls (1h)",
      "description": "Count of all adapter telemetry events in the last hour.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"adapter-telemetry\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hit rate",
      "description": "Fraction of calls served from L1 or L2 cache.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"adapter-telemetry\", outcome=\"hit\"}[1h])) / sum(count_over_time({app=\"adapter-telemetry\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.4 },
              { "color": "green", "value": 0.7 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error rate",
      "description": "Fraction of calls that ended in outcome=error.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"adapter-telemetry\", outcome=\"error\"}[1h])) / sum(count_over_time({app=\"adapter-telemetry\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Fallthrough rate",
      "description": "Fraction of calls that fell through to an upstream source (hydration signal).",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"adapter-telemetry\", outcome=~\"fallthrough_.*\"}[1h])) / sum(count_over_time({app=\"adapter-telemetry\"}[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Outcomes over time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Outcome rates (per-minute)",
      "description": "Stacked rate of each telemetry outcome over time.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (outcome) (rate({app=\"adapter-telemetry\"}[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Per-method breakdown",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 20,
      "type": "table",
      "title": "Top 20 methods by call volume",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 17 },
      "targets": [
        {
          "expr": "topk(20, sum by (method) (count_over_time({app=\"adapter-telemetry\"}[1h])))",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "table",
      "title": "Top fallthrough methods (hydration candidates)",
      "description": "Methods most often falling through to upstream. Use this to prioritize what data to ingest next.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 17 },
      "targets": [
        {
          "expr": "topk(20, sum by (method) (count_over_time({app=\"adapter-telemetry\", outcome=~\"fallthrough_.*\"}[24h])))",
          "format": "table",
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "p99 latency by method (ms)",
      "description": "99th percentile client-observed latency for the top-10 call volume methods.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "quantile_over_time(0.99, {app=\"adapter-telemetry\"} | json | unwrap latency_ms [5m]) by (method)",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "Metering Proxy — JWT Minting (Feature 003)",
      "description": "JWT mint + inject metrics from the metering-proxy sidecar. Three-way binding: definition in metering_proxy/metrics.py, emission in proxy.py, consumption here.",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "JWTs Minted (per second, by tier)",
      "description": "Rate of successfully minted JWTs per consumer tier. One increment per request that reaches PostgREST with a valid Bearer JWT. Steady-state: proportional to request rate.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 39 },
      "targets": [
        {
          "expr": "sum by (tier) (rate(dk_data_metering_jwt_minted_total[1m]))",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "stacking": { "mode": "normal", "group": "A" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "JWT Mint Errors (by error type)",
      "description": "Rate of JWT mint failures by error type. Expected steady-state: zero. Non-zero means the proxy is 500-ing requests — check missing secret, unknown tier, or code bug.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 39 },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(dk_data_metering_jwt_mint_errors_total[5m]))",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20
          },
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "Requests Forwarded Without JWT (FR-010 bug-detector)",
      "description": "FR-010: any request forwarded to PostgREST without a minted JWT lands as dk_data_no_anon (zero grants). Expected steady-state: zero. Any non-zero value is a bug — investigate bypass path in proxy.py.",
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 49 },
      "targets": [
        {
          "expr": "rate(dk_data_metering_requests_forwarded_without_jwt_total[5m])",
          "legendFormat": "requests without JWT",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 30
          },
          "color": { "mode": "fixed", "fixedColor": "dark-red" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.0001 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["dk-data", "adapter", "telemetry", "feature-002"],
