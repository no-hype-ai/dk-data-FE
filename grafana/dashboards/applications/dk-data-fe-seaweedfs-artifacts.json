{
  "__metadata": {
    "folder": "applications"
  },
  "dashboard": {
    "uid": "dk-data-fe-seaweedfs-artifacts",
    "title": "dk-data SeaweedFS Artifacts",
    "description": "Download-integrity pipeline health: artifact change detection, size-mismatch events, and provenance-writer self-telemetry. Reads Mimir counters emitted by the downloader + meta.artifact_provenance via the postgres datasource (plan.md \u00a7C.4, feature/005 PR #313, migration 229).",
    "tags": [
      "dk-data-fe",
      "hydration",
      "seaweedfs",
      "integrity",
      "observability"
    ],
    "schemaVersion": 39,
    "editable": true,
    "refresh": "1m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "timepicker": {},
    "timezone": "",
    "templating": {
      "list": [
        {
          "name": "source",
          "type": "query",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refresh": 2,
          "query": "label_values(dk_artifact_changed_total, source)",
          "includeAll": true,
          "multi": true,
          "allValue": ".*",
          "current": {
            "selected": false,
            "text": "All",
            "value": "$__all"
          }
        }
      ]
    },
    "annotations": {
      "list": []
    },
    "panels": [
      {
        "id": 1,
        "type": "timeseries",
        "title": "Artifacts changed per hour by source",
        "description": "Rate at which re-downloaded artifacts have a sha256 that differs from the prior row in meta.artifact_provenance. Each increment signals that downstream transforms (bronze \u2192 silver) must re-run even if rowcount matches \u2014 the bits changed, the semantics may have changed too. Consumed by the DkArtifactChanged PrometheusRule.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": ["sum", "max"]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "expr": "sum by (source) (rate(dk_artifact_changed_total{source=~\"$source\"}[1h]))",
            "legendFormat": "{{source}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Size-mismatch events",
        "description": "Rate of downloads where written bytes != Content-Length header. A non-zero rate means the downloader is receiving truncated responses from an upstream (or the upstream is setting a wrong Content-Length). The DkArtifactSizeMismatch PrometheusRule pages on any non-zero rate.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 9,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 20
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": ["sum", "max"]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "expr": "sum by (source) (rate(dk_artifact_size_mismatch_total{source=~\"$source\"}[5m]))",
            "legendFormat": "{{source}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "type": "timeseries",
        "title": "Provenance write errors (swallowed)",
        "description": "Rate of provenance writes that failed and were swallowed so the download could complete. The download still succeeds, but we lose the ability to detect a future sha256-change because no baseline was recorded. Any non-zero rate is anomalous \u2014 consumed by the DkProvenanceWriteErrors PrometheusRule.",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "h": 9,
          "w": 24,
          "x": 0,
          "y": 9
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "linear",
              "fillOpacity": 10
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": ["sum", "max"]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        },
        "targets": [
          {
            "expr": "sum by (source) (rate(dk_artifact_provenance_write_errors_total{source=~\"$source\"}[5m]))",
            "legendFormat": "{{source}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "type": "table",
        "title": "Latest provenance row per source",
        "description": "Most recent meta.artifact_provenance row per source with the URL, sha256, byte count, and when it was recorded. Use this to verify that a freshly-downloaded artifact's hash is what you expect. If the postgres datasource isn't provisioned, this panel shows `No data` \u2014 the counter-based panels above still work.",
        "datasource": {
          "type": "postgres",
          "uid": "postgres"
        },
        "gridPos": {
          "h": 12,
          "w": 24,
          "x": 0,
          "y": 18
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "left"
            }
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "bytes" },
              "properties": [
                { "id": "unit", "value": "bytes" }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "footer": {
            "show": false,
            "reducer": ["sum"],
            "fields": ""
          }
        },
        "targets": [
          {
            "rawSql": "SELECT DISTINCT ON (source) source, url, sha256, bytes, etag, recorded_at FROM meta.artifact_provenance ORDER BY source, recorded_at DESC",
            "format": "table",
            "rawQuery": true,
            "refId": "A"
          }
        ]
      }
    ]
  }
}
