{
  "__metadata": {
    "folder": "applications"
  },
  "dashboard": {
    "uid": "dk-data-fe-api-services",
    "title": "dk-data API Services",
    "tags": [
      "dk-data"
    ],
    "timezone": "browser",
    "editable": true,
    "panels": [
      {
        "title": "Request Rate",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{service=\"job-trigger\", product=\"dk-data\"}[5m]))",
            "legendFormat": "req/s"
          }
        ]
      },
      {
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{service=\"job-trigger\", product=\"dk-data\", http_status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"job-trigger\", product=\"dk-data\"}[5m]))",
            "legendFormat": "error %"
          }
        ]
      },
      {
        "title": "P95 Latency",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"job-trigger\", product=\"dk-data\"}[5m])) by (le))",
            "legendFormat": "p95"
          }
        ]
      },
      {
        "title": "Memory Usage",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "container_memory_working_set_bytes{container=\"job-trigger\", namespace=~\"dk-data-(prod|staging)\"}",
            "legendFormat": "{{namespace}}"
          }
        ]
      },
      {
        "title": "CPU Usage",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{container=\"job-trigger\", namespace=~\"dk-data-(prod|staging)\"}[5m])",
            "legendFormat": "{{namespace}}"
          }
        ]
      },
      {
        "title": "Pod Restarts",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "sum(increase(kube_pod_container_status_restarts_total{container=\"job-trigger\", exported_namespace=~\"dk-data-(prod|staging)\"}[24h]))",
            "legendFormat": "restarts (24h)"
          }
        ]
      },
      {
        "collapsed": false,
        "gridPos": {
          "h": 1,
          "w": 24,
          "x": 0,
          "y": 25
        },
        "id": 500,
        "title": "PostgREST Overview",
        "type": "row"
      }
    ],
    "templating": {
      "list": []
    },
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "refresh": "30s",
    "schemaVersion": 39,
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": {
            "type": "grafana",
            "uid": "-- Grafana --"
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    }
  }
}
