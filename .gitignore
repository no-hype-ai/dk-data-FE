# Data files (large datasets should not be committed)
# Store in MinIO instead: mc cp --recursive data/raw/ dk-minio/dk-data-fe/raw/
/data/
!/data/README.md
!/data/.gitkeep
# Also ignore data files in nested locations
data/*.tsv
data/*.tsv.gz
data/*.zip
data/*.xml
data/*.gz
*.csv
*.xlsx
*.json
!tests/fixtures/*.json
!.specify/**/*.json
!src/dk_data/frontend/*.json
!src/dk_data/frontend/package.json
!src/dk_data/frontend/tsconfig.json
!src/dk_data/frontend/tsconfig.node.json

# SQLMesh cache and state
.sqlmesh/
.cache/

