# Logs
*.log
/logs/
!/logs/.gitkeep
!/logs/README.md

# Data files (large datasets should not be committed)
# Store in MinIO instead: mc cp --recursive data/raw/ dk-minio/dk-data-fe/raw/
# Use /data/* (not /data/) so git traverses the directory and negations work
/data/*
!/data/README.md
!/data/.gitkeep
# Exception: DrugBank seed data (Git LFS, ~195MB zip baked into Docker image)
!/data/drugbank/
!/data/drugbank/*
src/dk_data/data/raw/
*.csv
*.xlsx
*.json
!tests/fixtures/*.json
!.specify/**/*.json
!monitoring/dashboards/*.json

# SQLMesh cache and state
.sqlmesh/
.cache/

# Coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# pytest
.pytest_cache/

# mypy
.mypy_cache/

# Temporary files
*.tmp
*.temp
tmp/
temp/
